{
  "name": "fullstack-javascript-roadmap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository-first competency-based Fullstack JavaScript curriculum",
  "scripts": {
    "dev": "pnpm --filter @roadmap/docs dev",
    "docs:build": "pnpm --filter @roadmap/docs build",
    "docs:check": "pnpm --filter @roadmap/docs check",
    "docs:test:e2e": "pnpm docs:build && pnpm --filter @roadmap/docs test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "environment:verify": "node scripts/ci/verify-environment.mjs",
    "check": "node scripts/run-pipeline.mjs format:check lint typecheck policy:check docs:check",
    "policy:check": "node scripts/check-repository-policy.mjs",
    "test": "node scripts/run-pipeline.mjs test:bootstrap test:unit",
    "test:bootstrap": "node --test scripts/*.test.mjs scripts/ci/tests/*.test.mjs",
    "test:wp-00-01-gate": "node --test scripts/wp-00-01-gate.integration.mjs",
    "test:unit": "vitest run",
    "verify:wp-00-01": "node scripts/verify-wp-00-01.mjs",
    "verify:wp-02-03": "node scripts/verify-wp-02-03.mjs",
    "verify:wp-04": "node scripts/verify-wp-04.mjs",
    "verify": "node scripts/run-pipeline.mjs environment:verify check test content:validate:curriculum docs:build",
    "verify:templates": "node scripts/run-pipeline.mjs verify:templates:publication verify:templates:learner",
    "verify:templates:publication": "tsx scripts/verify-all-templates.ts",
    "verify:templates:learner": "tsx scripts/verify-template-learner-contract.ts",
    "verify:wp10": "tsx scripts/verify-wp10-skeleton.ts",
    "verify:negative-fixtures": "node scripts/ci/run-negative-fixtures.mjs",
    "template:dry-run": "tsx tooling/publish-templates/src/main.ts",
    "verify:release": "node scripts/ci/verify-public-contract.mjs",
    "release:gate": "node scripts/verify-release-0.mjs .tmp/release-evidence",
    "content:validate": "pnpm --filter @roadmap/validate-content start --",
    "exercise:verify": "tsx tooling/verify-exercise/src/main.ts",
    "content:validate:curriculum": "pnpm content:validate curriculum --format json",
    "schema:generate": "tsx scripts/generate-json-schema.ts",
    "schema:check": "pnpm schema:generate && git diff --exit-code -- packages/curriculum-schema/generated/curriculum.schema.json packages/rubric-schema/generated/rubric.schema.json packages/evidence-schema/generated/evidence-manifest.schema.json packages/assessment-core/generated/remediation-catalog.schema.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@roadmap/assessment-core": "workspace:*",
    "@roadmap/command-runner": "workspace:*",
    "@roadmap/curriculum-graph": "workspace:*",
    "@roadmap/curriculum-loader": "workspace:*",
    "@roadmap/curriculum-schema": "workspace:*",
    "@roadmap/publish-templates": "workspace:*",
    "@roadmap/release-plan-schema": "workspace:*",
    "@roadmap/rubric-schema": "workspace:*",
    "@roadmap/validation-core": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "24.13.3",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
