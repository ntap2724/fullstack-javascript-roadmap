{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:track|gate|module|lesson|assessment|milestone|project|exercise|ex|lab|check|rubric|evidence|release|remediation|change-request|debugging)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "pattern": "^rubric-"
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "competency": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "test-report",
                "source-diff",
                "explanation",
                "observation-report",
                "debugging-report"
              ]
            }
          },
          "levels": {
            "type": "object",
            "properties": {
              "0": {
                "type": "string",
                "minLength": 1
              },
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["0", "1", "2", "3"],
            "additionalProperties": false
          }
        },
        "required": ["id", "title", "critical", "required", "competency", "evidence", "levels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "id", "version", "title", "criteria"],
  "additionalProperties": false,
  "$comment": "Draft 2020-12 cannot express uniqueness of criteria[].id across distinct objects. This schema provides structural prevalidation only; every supported consumer must also parse the rubric with RubricSchema."
}
