            "type": "string"
          }
        },
        "introducedIn": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lastReviewedIn": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "kind": {
          "type": "string",
          "const": "project"
        },
        "competencies": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
          }
        },
        "contractPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "slug",
        "title",
        "description",
        "status",
        "prerequisites",
        "introducedIn",
        "lastReviewedIn",
        "kind",
        "competencies",
        "contractPath"
      ],
      "additionalProperties": false
    }
  ]
}
