# Dependencies and build output are regenerated by `pnpm install` and `pnpm build`.
# Committing them makes reviews unreadable and your evidence untrustworthy.
node_modules/
dist/
coverage/

# Real environment values are secrets. `.env.example` is the committed template.
.env
.env.*
!.env.example

# Local tooling and editor noise.
*.log
.DS_Store
Thumbs.db
