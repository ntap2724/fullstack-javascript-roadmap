{
  "name": "@workshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test:infrastructure": "vitest run --config vitest.config.ts test/infrastructure.test.ts",
    "test:learner": "vitest run --config vitest.config.ts test/learner.test.ts",
    "test": "pnpm test:infrastructure"
  },
  "dependencies": {
    "@workshop/contracts": "workspace:*",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
