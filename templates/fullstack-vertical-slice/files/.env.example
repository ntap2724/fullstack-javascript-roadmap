# Local development environment for the Workshop Enrollment starter.
#
# Copy this file to .env and replace the placeholders with local values.
#
#   cp .env.example .env
#
# .env is git-ignored and is never published. Never put a real credential, a
# production connection string, or a deployed secret in this file: .env.example
# is committed and public.

# --- Web application (apps/web) -------------------------------------------
# Vite exposes only variables prefixed with VITE_ to browser code. Anything
# here is readable by anyone who loads the site, so it must never be a secret.
# Base URL of the API the SPA calls. No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# --- API application (apps/api) -------------------------------------------
# Validated by apps/api/src/config.ts at process start. The API refuses to
# start when any of these is missing or malformed.

# Port the API listens on.
PORT=3000

# PostgreSQL connection string. Must use the postgres: or postgresql: protocol.
# Local development credentials only.
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/workshop_enrollment

# Exact browser origin allowed to send credentialed requests. Must use http: or
# https:. This is the CORS and CSRF Origin allowlist, so keep it exact.
WEB_ORIGIN=http://localhost:5173

# Whether the session cookie carries the Secure attribute. Use false for plain
# http://localhost development and true for every HTTPS deployment.
SESSION_COOKIE_SECURE=false

# Session lifetime in minutes. Positive integer.
SESSION_TTL_MINUTES=120
